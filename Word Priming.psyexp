  <Flow>
    <LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'study_word': 'Laptop'}, {'study_word': 'Chart '}, {'study_word': 'Tshirt '}, {'study_word': 'Mouse '}, {'study_word': 'Pastry '}, {'study_word': 'Case'}, {'study_word': 'Cruise '}, {'study_word': 'Police '}, {'study_word': 'Keys '}, {'study_word': 'Poster '}, {'study_word': 'Board '}, {'study_word': 'Marble '}, {'study_word': 'Phone '}, {'study_word': 'Book'}, {'study_word': 'Cushion '}, {'study_word': 'Table '}, {'study_word': 'Pencil'}, {'study_word': 'Vase '}, {'study_word': 'Bottle'}, {'study_word': 'Camera '}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="extras/study_words.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="trials" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="trial"/>
    <LoopTerminator name="trials"/>
